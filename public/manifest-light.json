{
  "id": "com.reco.app",
  "name": "Reco",
  "short_name": "Reco",
  "description": "Reco - Wholesale Receipt Search and Instant On-Device Inventory Indexer.",
  "start_url": "/?mode=standalone",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "window-controls-overlay", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#fff0f3",
  "theme_color": "#fff0f3",
  "categories": ["shopping", "productivity", "utilities", "finance"],
  "icons": [
    {
      "src": "/icons/icon-light-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-light-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-light-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-light-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "/manifest-light.json",
      "id": "com.reco.app"
    }
  ],
  "prefer_related_applications": false
}
