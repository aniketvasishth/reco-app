{
  "id": "com.reco.app",
  "name": "Reco",
  "short_name": "Reco",
  "description": "Reco - Wholesale Receipt Search and Instant On-Device Inventory Indexer.",
  "start_url": "/?mode=standalone",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "window-controls-overlay", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#14060b",
  "theme_color": "#14060b",
  "categories": ["shopping", "productivity", "utilities", "finance"],
  "icons": [
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-dark-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-dark-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "/manifest.json",
      "id": "com.reco.app"
    }
  ],
  "prefer_related_applications": false,
  "shortcuts": [
    {
      "name": "Scan Receipt",
      "short_name": "Scan",
      "description": "Snap a photo of wholesale paper receipt",
      "url": "/?action=scan",
      "icons": [{ "src": "/icons/icon-dark-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Search Items",
      "short_name": "Search",
      "description": "Quickly search all items and prices",
      "url": "/?action=search",
      "icons": [{ "src": "/icons/icon-dark-192.png", "sizes": "192x192" }]
    }
  ]
}
